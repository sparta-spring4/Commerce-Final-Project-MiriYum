# 이 파일을 EC2의 /opt/miriyum/.env로 복사한 뒤 모든 예시 값을 서버에서 교체한다.
MYSQL_DATABASE=miriyum
AWS_REGION=ap-northeast-2
BACKEND_IMAGE=example.invalid/miriyum-backend:local
MYSQL_USER=miriyum
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
MIRIYUM_JWT_SECRET=replace-with-a-32-byte-or-longer-jwt-secret
MIRIYUM_JWT_ISSUER=miriyum
MIRIYUM_PLATFORM_OPERATOR_REAUTH_FINGERPRINT_SECRET=replace-with-a-dedicated-32-byte-or-longer-secret
MIRIYUM_ALLOWED_ORIGIN=http://localhost:5173
MIRIYUM_IDENTITY_VERIFICATION_STUB_ENABLED=false
# 매장 등록의 주소 검증에 사용하는 카카오 Local REST API 키다. OAuth 키와 공유하지 않는다.
MIRIYUM_STORE_GEOCODING_REST_API_KEY=
# Kakao OAuth를 활성화할 때만 채운다. fingerprint 키는 JWT 키와 분리해서 사용한다.
MIRIYUM_KAKAO_ENABLED=false
MIRIYUM_KAKAO_REST_API_KEY=
MIRIYUM_KAKAO_CLIENT_SECRET=
MIRIYUM_KAKAO_REDIRECT_URIS=
MIRIYUM_KAKAO_STATE_SECRET=
MIRIYUM_KAKAO_SIGN_UP_TICKET_SECRET=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_ACTIVE_KEY_VERSION=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_ACTIVE_SECRET=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_PREVIOUS_KEY_VERSION=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_PREVIOUS_SECRET=
MIRIYUM_NOTIFICATION_HISTORY_CURSOR_SECRET=
MIRIYUM_REFRESH_RISK_EVENT_DELIVERY_ENABLED=true
MIRIYUM_RESERVATION_HOLD_EXPIRATION_ENABLED=true
MIRIYUM_NOTIFICATION_WORKER_ENABLED=false
MIRIYUM_NOTIFICATION_WORKER_POLICY_VERSION=
MIRIYUM_NOTIFICATION_WORKER_ID=
MIRIYUM_NOTIFICATION_WORKER_BATCH_SIZE=0
MIRIYUM_NOTIFICATION_WORKER_LEASE_DURATION_MS=0
MIRIYUM_NOTIFICATION_WORKER_MAX_ATTEMPTS=0
MIRIYUM_NOTIFICATION_WORKER_INITIAL_RETRY_DELAY_MS=0
MIRIYUM_NOTIFICATION_WORKER_MAX_RETRY_DELAY_MS=0
MIRIYUM_NOTIFICATION_WORKER_POLL_DELAY_MS=60000
MIRIYUM_NOTIFICATION_WORKER_INITIAL_DELAY_MS=60000
MIRIYUM_WAITING_CLOSURE_ENABLED=false
MIRIYUM_VALKEY_HOST=valkey
MIRIYUM_VALKEY_PORT=6379
MIRIYUM_VALKEY_PASSWORD=replace-with-a-strong-valkey-password
