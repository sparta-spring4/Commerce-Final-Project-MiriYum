# 이 파일을 같은 디렉터리의 .env로 복사해 사용한다. .env는 Git에 포함하지 않는다.
# 로컬 전용 값이며 staging·production 비밀값과 공유하지 않는다.

MYSQL_DATABASE=miriyum
MYSQL_USER=miriyum
MYSQL_PASSWORD=local-dev-password
MYSQL_ROOT_PASSWORD=local-dev-root-password

# 호스트에 이미 MySQL이 3306을 쓰고 있을 수 있어 기본값을 3307로 둔다.
MYSQL_HOST_PORT=3307

# 로컬 전용 서명 키다. 32 byte 이상이어야 하며 운영 키를 재사용하지 않는다.
MIRIYUM_JWT_SECRET=local-dev-jwt-secret-change-me-32bytes-min
MIRIYUM_JWT_ISSUER=miriyum
MIRIYUM_PLATFORM_OPERATOR_REAUTH_FINGERPRINT_SECRET=local-dev-platform-operator-reauth-secret-change-me

# Vite dev server 오리진과 정확히 일치해야 한다. 포트를 바꾸면 여기도 함께 바꾼다.
MIRIYUM_ALLOWED_ORIGIN=http://localhost:5173

# 본인확인 제공업체 미선정 상태라 로컬에서는 켜 둔다. 끄면 가입이 COMMON_012로 차단된다.
MIRIYUM_IDENTITY_VERIFICATION_STUB_ENABLED=true

# Kakao OAuth를 로컬에서 검증할 때만 채운다. fingerprint 키는 JWT 키와 분리해서 사용한다.
MIRIYUM_KAKAO_ENABLED=false
MIRIYUM_KAKAO_REST_API_KEY=
MIRIYUM_KAKAO_CLIENT_SECRET=
MIRIYUM_KAKAO_REDIRECT_URIS=
MIRIYUM_KAKAO_STATE_SECRET=
MIRIYUM_KAKAO_SIGN_UP_TICKET_SECRET=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_ACTIVE_KEY_VERSION=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_ACTIVE_SECRET=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_PREVIOUS_KEY_VERSION=
MIRIYUM_KAKAO_IDENTITY_FINGERPRINT_PREVIOUS_SECRET=

# 로컬 Valkey와 QR epoch restore fence다. volume을 복원한 경우 이전에 쓰지 않은 값으로 바꾼다.
MIRIYUM_VALKEY_PASSWORD=local-dev-valkey-password
MIRIYUM_QR_STORAGE_GENERATION=local-v1
