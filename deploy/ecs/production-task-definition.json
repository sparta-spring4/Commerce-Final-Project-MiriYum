{
  "family": "miriyum-production-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "REPLACE_WITH_ECS_TASK_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_ECS_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "REPLACE_WITH_ECR_IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "MIRIYUM_JWT_ISSUER", "value": "miriyum"},
        {"name": "MIRIYUM_ALLOWED_ORIGIN", "value": "REPLACE_WITH_HTTPS_ORIGIN"},
        {"name": "MIRIYUM_QR_STORAGE_GENERATION", "value": "prod-v1"},
        {"name": "MIRIYUM_IDENTITY_VERIFICATION_STUB_ENABLED", "value": "false"},
        {"name": "MIRIYUM_KAKAO_ENABLED", "value": "false"},
        {"name": "MIRIYUM_RUNTIME_CONFIG_ENABLED", "value": "false"},
        {"name": "MIRIYUM_STORAGE_S3_ENABLED", "value": "true"},
        {"name": "MIRIYUM_STORAGE_S3_RECONCILIATION_ENABLED", "value": "false"},
        {"name": "MIRIYUM_STORAGE_S3_REGION", "value": "ap-northeast-2"},
        {"name": "MIRIYUM_STORE_SEARCH_LLM_ENABLED", "value": "true"},
        {"name": "MIRIYUM_STORE_SEARCH_LLM_MODEL", "value": "gpt-4o-mini"},
        {"name": "MIRIYUM_STORE_SEARCH_LLM_RESPONSE_TIMEOUT_MS", "value": "5000"},
        {"name": "MIRIYUM_CLOUDWATCH_METRICS_ENABLED", "value": "true"},
        {"name": "MIRIYUM_CLOUDWATCH_METRICS_NAMESPACE", "value": "MiriYum/Production"},
        {"name": "MIRIYUM_PAYMENT_ENABLED", "value": "false"},
        {"name": "MIRIYUM_REFRESH_RISK_EVENT_DELIVERY_ENABLED", "value": "true"},
        {"name": "MIRIYUM_RESERVATION_DEPOSIT_WORKER_ENABLED", "value": "true"},
        {"name": "MIRIYUM_WAITING_CLOSURE_ENABLED", "value": "false"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_ENABLED", "value": "false"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_WORKER_ID", "value": ""},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_PLANNING_HORIZON", "value": "PT0S"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_PLANNING_BATCH_SIZE", "value": "0"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_CLAIM_BATCH_SIZE", "value": "0"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_LEASE_DURATION", "value": "PT0S"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_MAX_ATTEMPTS", "value": "0"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_INITIAL_RETRY_DELAY", "value": "PT0S"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_MAXIMUM_RETRY_DELAY", "value": "PT0S"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_INVALIDATION_BATCH_SIZE", "value": "0"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_POLL_DELAY", "value": "PT0S"},
        {"name": "MIRIYUM_WAITING_AUTO_OPEN_INITIAL_DELAY", "value": "PT0S"},
        {"name": "MIRIYUM_VALKEY_HOST", "value": "REPLACE_WITH_VALKEY_ENDPOINT"},
        {"name": "MIRIYUM_VALKEY_PORT", "value": "6379"},
        {"name": "MIRIYUM_VALKEY_SSL_ENABLED", "value": "true"}
      ],
      "secrets": [
        {"name": "MIRIYUM_DB_URL", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_DB_URL::"},
        {"name": "MIRIYUM_DB_USERNAME", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_DB_USERNAME::"},
        {"name": "MIRIYUM_DB_PASSWORD", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_DB_PASSWORD::"},
        {"name": "MIRIYUM_JWT_SECRET", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_JWT_SECRET::"},
        {"name": "MIRIYUM_STORE_GEOCODING_REST_API_KEY", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_STORE_GEOCODING_REST_API_KEY::"},
        {"name": "MIRIYUM_NOTIFICATION_HISTORY_CURSOR_SECRET", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_NOTIFICATION_HISTORY_CURSOR_SECRET::"},
        {"name": "MIRIYUM_WAITING_HISTORY_CURSOR_SECRET", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_WAITING_HISTORY_CURSOR_SECRET::"},
        {"name": "MIRIYUM_VALKEY_PASSWORD", "valueFrom": "REPLACE_WITH_APPLICATION_SECRET_ARN:MIRIYUM_VALKEY_PASSWORD::"},
        {"name": "MIRIYUM_STORAGE_S3_BUCKET", "valueFrom": "REPLACE_WITH_MIRIYUM_STORAGE_S3_BUCKET_PARAMETER_ARN"},
        {"name": "OPENAI_API_KEY", "valueFrom": "REPLACE_WITH_OPENAI_API_KEY_PARAMETER_ARN"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "REPLACE_WITH_PRODUCTION_LOG_GROUP",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
