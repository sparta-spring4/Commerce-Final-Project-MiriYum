server {
    listen 80;
    server_name ${STAGING_DOMAIN};

    # Keep the ACME HTTP-01 challenge reachable after HTTPS is enabled for renewals.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    # Actuator is intentionally private on both HTTP and HTTPS ingress paths.
    location /actuator/ {
        return 404;
    }

    location / {
        return 301 https://${STAGING_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${STAGING_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${STAGING_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${STAGING_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /actuator/ {
        return 404;
    }

    location / {
        return 404;
    }
}
